-      parseFloat(r.caja_mes.devoluciones)          > 0 ? `${UI.moneda(r.caja_mes.devoluciones)} devuelto` : null,
+      `${UI.moneda(r.caja_mes.ingresos)} en ${r.caja_mes.cantidad_pagos} pago${r.caja_mes.cantidad_pagos===1?'':'s'}`,
