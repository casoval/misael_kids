+          onclick="quitarVinculoTutor('${t.id}')">🗑️</button>
+      </div>`).join('');
+  } catch { cont.innerHTML = ''; }
+}
+
+async function quitarVinculoTutor(vinculoId) {
+  if (!confirm('¿Quitar el vínculo con este tutor? (el tutor no se elimina, solo se desvincula de este niño/a)')) return;
