+  try {
+    const nino = await API.get('/ninos/ninos/'+ninoId+'/');
+    const personas = [
+      ...(nino.tutores||[]).filter(t=>t.puede_retirar!==false).map(t=>t.tutor_nombre),
+      ...(nino.autorizados||[]).filter(a=>a.activa!==false).map(a=>a.nombres+' '+a.apellidos),
+    ];
+    dl.innerHTML = personas.map(p=>'<option value="'+p.replace(/"/g,'')+'">').join('');
+    if (personas.length) {
+      aviso.style.display = 'block';
+      aviso.innerHTML = '✅ Autorizados a retirar: ' + personas.join(', ');
+    } else {
+      aviso.style.display = 'block';
+      aviso.style.background = 'var(--coral-l)';
+      aviso.style.color = 'var(--coral-d)';
+      aviso.innerHTML = '⚠️ Este niño/a no tiene tutores ni personas autorizadas registradas.';
+    }
