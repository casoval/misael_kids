+        opt.textContent = t.nombres+' '+t.apellidos+' ('+(t.parentesco_display||t.parentesco)+')';
+        sel.appendChild(opt);
+      });
+  } catch {}
+}
+
+function irARegistrarTutor() {
+  window.location.href = editandoId ? '/panel/tutores/?nino='+editandoId : '/panel/tutores/';
+}
+
+async function agregarTutorVinculo() {
+  const tutorId = document.getElementById('tv-tutor').value;
+  if (!tutorId) { UI.toast('Selecciona un tutor','warn'); return; }
+  const tutor = _tutoresDisponibles.find(t=>t.id===tutorId);
+  const vinculo = {
+    tutor: tutorId,
+    tutor_nombre: tutor ? tutor.nombres+' '+tutor.apellidos : '',
+    es_principal:  document.getElementById('tv-principal').checked,
+    puede_retirar: document.getElementById('tv-retirar').checked,
+  };
+  document.getElementById('tv-principal').checked = false;
+  document.getElementById('tv-retirar').checked   = true;
+
+  if (editandoId) {
+    try {
+      await API.post('/ninos/tutores-nino/', {nino:editandoId, ...vinculo, tutor:tutorId});
+      UI.toast('Tutor vinculado','exito');
+      await cargarTutoresVinculados();
+      await cargarTutoresSelector();
+    } catch (err) { UI.toast('Error: '+err.message,'error'); }
+  } else {
+    tutoresPendientes.push(vinculo);
+    pintarTutoresPendientes();
+    cargarTutoresSelector();
+    UI.toast('Tutor agregado (se vinculará al guardar el niño/a)','info');
+  }
+}
+
+function pintarTutoresPendientes() {
+  const cont = document.getElementById('tutores-vinculados');
+  if (!tutoresPendientes.length) {
+    cont.innerHTML = '<p style="font-size:var(--text-sm);color:var(--texto-suave)">Aún no vinculaste ningún tutor a este niño/a</p>';
+    return;
+  }
+  cont.innerHTML = tutoresPendientes.map((t,i)=>`
+    <div class="tutor-item">
+      <div class="tutor-ava">${UI.iniciales(t.tutor_nombre)}</div>
+      <div style="flex:1">
+        <div style="font-weight:700;font-size:var(--text-sm)">${t.tutor_nombre}</div>
+        <div style="font-size:var(--text-xs);color:var(--texto-suave)">
+          ${t.es_principal?'⭐ Principal · ':''}${t.puede_retirar?'✅ Puede retirar':'❌ No puede retirar'}
+        </div>
+      </div>
+      <button class="btn btn-sm" style="background:var(--coral-l);color:var(--coral-d);border:1.5px solid var(--coral)"
+        onclick="quitarTutorPendiente(${i})">🗑️</button>
+    </div>`).join('');
+}
+
+function quitarTutorPendiente(i) {
+  tutoresPendientes.splice(i,1);
+  pintarTutoresPendientes();
+  cargarTutoresSelector();
+}
+
+async function cargarTutoresVinculados() {
+  if (!editandoId) return;
+  const cont = document.getElementById('tutores-vinculados');
+  try {
+    const data = await API.get('/ninos/tutores-nino/?nino='+editandoId);
+    const lista = data.results||data;
+    if (!lista.length) { cont.innerHTML = '<p style="font-size:var(--text-sm);color:var(--texto-suave)">Sin tutores vinculados todavía</p>'; return; }
+    cont.innerHTML = lista.map(t=>`
+      <div class="tutor-item" data-tutor-id="${t.tutor}">
+        <div class="tutor-ava">${UI.iniciales(t.tutor_nombre)}</div>
+        <div style="flex:1">
+          <div style="font-weight:700;font-size:var(--text-sm)">${t.tutor_nombre}</div>
+          <div style="font-size:var(--text-xs);color:var(--texto-suave)">
