+/* ═══════════════════════════════════════════════════════════════
+   Misael Kids — Temas
+   ───────────────────────────────────────────────────────────────
+   Cada tema es un bloque  :root[data-tema="id"] { ... }  que solo
+   redefine variables de variables.css. El tema por defecto
+   ("jardin", el look original) no necesita bloque.
+
+   Se activa con  <html data-tema="id">  (lo hace js/tema.js).
+
+   Para agregar un tema nuevo:
+     1. Copia un bloque de abajo y cambia el id y los valores.
+     2. Registra el id en js/tema.js (lista TEMAS).
+
+   Variables que conviene redefinir:
+     · Primario ....... --turquesa, -d (texto/acentos), -l (tinte), -xl,
+                        --primario-rgb (sombras con transparencia) y
+                        --primario-2 (2.º color de los degradados)
+     · Acento ......... --violeta, -d, -l
+     · Fondos ......... --fondo-panel, --fondo-grad (login/portal)
+     · Banner ......... --grad-hero (cabecera dashboard/portal)
+     · Forma .......... --radio-*, --sombra-*
+     · Tipografía ..... --font-display, --font-body
+     · Decoración ..... --deco-header (emojis del portal)
+═══════════════════════════════════════════════════════════════ */
+
+:root { color-scheme: var(--color-scheme); }
+
+
+/* ═══ 🌊 OCÉANO ═══════════════════════════════════════════════ */
+:root[data-tema="oceano"] {
+  --turquesa:    #0EA5E9;
+  --turquesa-d:  #0369A1;
+  --turquesa-l:  #E0F2FE;
+  --turquesa-xl: #F0F9FF;
+  --primario-rgb: 14, 165, 233;
+  --primario-2:  #22D3EE;
+
+  --violeta:     #6366F1;
+  --violeta-d:   #4338CA;
+  --violeta-l:   #E0E7FF;
+
+  --fondo-panel: linear-gradient(160deg, #F0F9FF 0%, #E3F2FB 100%);
+  --fondo-grad:  linear-gradient(135deg, #E0F2FE 0%, #F0F9FF 40%, #ECFEFF 70%, #DBEAFE 100%);
+  --grad-hero:   linear-gradient(135deg, #0369A1, #0E7490);
+  --deco-header: '🐠🌊🐚';
+}
+
+
+/* ═══ 🌅 DULCE ATARDECER ══════════════════════════════════════ */
+:root[data-tema="atardecer"] {
+  --turquesa:    #D946EF;
+  --turquesa-d:  #A21CAF;
+  --turquesa-l:  #FAE8FF;
+  --turquesa-xl: #FDF4FF;
+  --primario-rgb: 217, 70, 239;
+  --primario-2:  #FB923C;
+
+  --fondo-panel: linear-gradient(135deg, #FFF7ED 0%, #FDF4FF 100%);
+  --fondo-grad:  linear-gradient(135deg, #FFEDD5 0%, #FFE4F1 45%, #FAE8FF 75%, #FEF3C7 100%);
+  --grad-hero:   linear-gradient(135deg, #C026D3, #EA580C);
+  --deco-header: '🌅🦄🎈';
+
+  /* más redondeado y "blandito" */
+  --radio-md: 1rem;
+  --radio-lg: 1.25rem;
+  --radio-xl: 2rem;
+}
+
+
+/* ═══ 🚀 ESPACIO (oscuro) ═════════════════════════════════════ */
+:root[data-tema="espacio"] {
+  --color-scheme: dark;
+
+  /* primario violeta · acento cian */
+  --turquesa:    #8B5CF6;
+  --turquesa-d:  #A78BFA;
+  --turquesa-l:  #2B2158;
+  --turquesa-xl: #241C4D;
+  --primario-rgb: 139, 92, 246;
+  --primario-2:  #22D3EE;
+  --violeta:     #22D3EE;
+  --violeta-d:   #67E8F9;
+  --violeta-l:   #10394A;
+
+  /* estados: se aclaran para leerse sobre fondo oscuro */
+  --verde:       #34D399;  --verde-d:    #6EE7B7;  --verde-l:    #0F3A2E;
+  --coral:       #FB7185;  --coral-d:    #FDA4AF;  --coral-l:    #4A1D2C;  --coral-xl: #3A1824;
+  --amarillo:    #FACC15;  --amarillo-d: #FDE047;  --amarillo-l: #42370C;  --amarillo-txt: #FDE68A;
+  --naranja:     #FB923C;                          --naranja-l:  #4A2A12;
+
+  /* superficies y texto: escala de grises invertida */
+  --txt-rojo:    #FCA5A5;   --txt-verde:   #86EFAC;   --txt-azul:    #93C5FD;   --txt-naranja: #FDBA74;
+  --fila-deuda-bg: #3A1824; --ok-bg-suave: #0F3A2E;
+  --amarillo-l2: #4A3E10;   --amarillo-l3: #5A4A10;   --amarillo-xl: #3A300A;
+  --violeta-xl:  #0C2A38;   --coral-xl2:   #3F1A28;
+  --tinta:       #E9E9FA;   --tinta-inv:   #1A1A3A;
+  --texto-sobre-amarillo: #1A1A3A;   /* el amarillo sigue siendo claro: su texto debe ser oscuro */
+  --blanco:   #1A1A3A;
+  --gris-50:  #12122B;
+  --gris-100: #20204A;
+  --gris-200: #2E2E5E;
+  --gris-300: #44447A;
+  --gris-400: #8B8BBA;
+  --gris-500: #A3A3CE;
+  --gris-600: #C3C3E2;
+  --gris-700: #DADAF0;
+  --gris-800: #ECECFA;
+  --texto:       #E9E9FA;
+  --texto-suave: #A3A3CE;
+
+  --sombra-sm: 0 1px 3px rgba(0,0,0,.40), 0 1px 2px rgba(0,0,0,.30);
+  --sombra-md: 0 4px 8px rgba(0,0,0,.40), 0 2px 4px rgba(0,0,0,.30);
+  --sombra-lg: 0 10px 18px rgba(0,0,0,.45), 0 4px 6px rgba(0,0,0,.30);
+  --sombra-xl: 0 20px 28px rgba(0,0,0,.50), 0 10px 10px rgba(0,0,0,.30);
+
+  --fondo-grad:     linear-gradient(135deg, #0B0B24 0%, #1B1245 40%, #0F2A4A 75%, #1A0B2E 100%);
+  --grad-hero:      linear-gradient(135deg, #6D28D9, #0E7490);
+  --login-card-bg:  rgba(26, 26, 58, .92);
+  --deco-header:    '🚀🪐⭐';
+
+  --font-display: 'Righteous', 'Fredoka One', cursive;
+}
+/* estrellitas de fondo en el panel */
+:root[data-tema="espacio"] body {
+  background-image:
+    radial-gradient(1px   1px   at  20px  30px, rgba(255,255,255,.55), transparent),
+    radial-gradient(1px   1px   at 120px  80px, rgba(255,255,255,.40), transparent),
+    radial-gradient(1.5px 1.5px at 200px 150px, rgba(255,255,255,.60), transparent),
+    radial-gradient(1px   1px   at  70px 170px, rgba(167,139,250,.60), transparent);
+  background-size: 240px 200px;
+}
+/* calendarios (flatpickr) en oscuro */
+:root[data-tema="espacio"] .flatpickr-calendar,
+:root[data-tema="espacio"] .flatpickr-months .flatpickr-month,
+:root[data-tema="espacio"] .flatpickr-monthSelect-month { background: var(--blanco); color: var(--texto); }
+:root[data-tema="espacio"] .flatpickr-calendar { border: 1px solid var(--gris-200); }
+:root[data-tema="espacio"] .flatpickr-current-month .flatpickr-monthDropdown-months,
+:root[data-tema="espacio"] .flatpickr-current-month input.cur-year,
+:root[data-tema="espacio"] .flatpickr-day,
+:root[data-tema="espacio"] .flatpickr-monthSelect-month { color: var(--texto); }
+:root[data-tema="espacio"] .flatpickr-day.prevMonthDay,
+:root[data-tema="espacio"] .flatpickr-day.nextMonthDay,
+:root[data-tema="espacio"] .flatpickr-day.flatpickr-disabled { color: var(--gris-300); }
+:root[data-tema="espacio"] span.flatpickr-weekday { color: var(--texto-suave); background: transparent; }
+:root[data-tema="espacio"] .flatpickr-months .flatpickr-prev-month svg,
+:root[data-tema="espacio"] .flatpickr-months .flatpickr-next-month svg { fill: var(--texto); }
+:root[data-tema="espacio"] .flatpickr-day.selected,
+:root[data-tema="espacio"] .flatpickr-day.selected:hover { color: #fff; }
+
+
+/* ═══ 📒 PAPEL (sobrio) ═══════════════════════════════════════ */
+:root[data-tema="papel"] {
+  --turquesa:    #2563EB;
+  --turquesa-d:  #1D4ED8;
+  --turquesa-l:  #DBEAFE;
+  --turquesa-xl: #EFF6FF;
+  --primario-rgb: 37, 99, 235;
+  --primario-2:  #3B82F6;
+
+  --fondo-panel: #F5F4F0;
+  --fondo-grad:  linear-gradient(#F5F4F0, #F5F4F0);
+  --grad-hero:   linear-gradient(135deg, #1E40AF, #2563EB);
+  --deco-header: '';
+
+  /* formas más serias: radios chicos y sombras casi planas */
+  --radio-sm: .25rem;
+  --radio-md: .375rem;
+  --radio-lg: .5rem;
+  --radio-xl: .75rem;
+  --sombra-sm:    0 1px 2px rgba(0,0,0,.05);
+  --sombra-md:    0 1px 3px rgba(0,0,0,.08);
+  --sombra-lg:    0 2px 6px rgba(0,0,0,.08);
+  --sombra-xl:    0 6px 16px rgba(0,0,0,.10);
+  --sombra-color: 0 1px 2px rgba(0,0,0,.10);
+
+  --font-body:    'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  --font-display: 'DM Serif Display', Georgia, 'Times New Roman', serif;
+}
+/* sin adornos: ni burbujas, ni estrellitas, ni líneas punteadas */
+:root[data-tema="papel"] .burbuja,
+:root[data-tema="papel"] .estrellita,
+:root[data-tema="papel"] .bg-burbujas::before,
+:root[data-tema="papel"] .bg-burbujas::after { display: none; }
+:root[data-tema="papel"] .sidebar-logo,
+:root[data-tema="papel"] .card-header,
+:root[data-tema="papel"] .tabla-apilada tbody td { border-bottom-style: solid; }
+:root[data-tema="papel"] .sidebar-footer,
+:root[data-tema="papel"] .tn-datos,
+:root[data-tema="papel"] .tn-acciones   { border-top-style: solid; }
+
+
+/* ═══ Decoración del portal controlada por tema ═══════════════ */
+.portal-header::before { content: var(--deco-header, '🌸🌟🦋'); }
+
+
+/* ═══════════════════════════════════════════════════════════════
+   SELECTOR DE TEMA  (lo construye Tema.montar() en js/tema.js)
+   Es autosuficiente: funciona también en login, que no carga base.css
+═══════════════════════════════════════════════════════════════ */
+.tema-selector { position: relative; font-family: var(--font-body); }
+
+.tema-btn {
+  display: flex; align-items: center; gap: .5rem; width: 100%;
+  padding: .45rem .65rem; margin-bottom: var(--gap-sm);
+  border: 1.5px solid var(--gris-200); border-radius: var(--radio-lg);
+  background: var(--blanco); color: var(--texto);
+  font: 700 var(--text-sm) var(--font-body);
+  cursor: pointer; text-align: left;
+  transition: border-color var(--trans-fast), background var(--trans-fast);
+}
+.tema-btn:hover { border-color: var(--turquesa); }
+.tema-btn:focus-visible, .tema-op:focus-visible { outline: 3px solid rgba(var(--primario-rgb), .45); outline-offset: 1px; }
+.tema-btn .tema-nombre { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tema-btn .tema-flecha { font-size: .65rem; opacity: .6; }
+
+.tema-puntos { display: inline-flex; flex-shrink: 0; }
+/* en el sidebar no hay ancho: el nombre ya dice el tema y las muestras están en el menú */
+.tema-selector:not([data-variante]) .tema-puntos { display: none; }
+.tema-puntos i {
+  width: 11px; height: 11px; border-radius: 50%;
+  border: 1.5px solid var(--blanco); margin-left: -4px;
+}
+.tema-puntos i:first-child { margin-left: 0; }
+
+.tema-menu {
+  display: none; position: absolute; z-index: 10000;
+  bottom: calc(100% + 4px); left: 0; min-width: 232px;
+  padding: .4rem; background: var(--blanco);
+  border: 1.5px solid var(--gris-200); border-radius: var(--radio-lg);
+  box-shadow: var(--sombra-xl);
+}
+.tema-selector.abierto .tema-menu { display: block; animation: temaPop .14s ease-out; }
+@keyframes temaPop { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
+
+.tema-menu-titulo {
+  padding: .35rem .6rem .25rem; font-size: var(--text-xs); font-weight: 800;
+  text-transform: uppercase; letter-spacing: .06em; color: var(--gris-400);
+}
+.tema-op {
+  display: flex; align-items: center; gap: .65rem; width: 100%;
+  padding: .45rem .6rem; border: none; border-radius: var(--radio-md);
+  background: none; color: var(--texto); cursor: pointer; text-align: left;
+  font: 700 var(--text-sm) var(--font-body);
+}
+.tema-op:hover { background: var(--gris-100); }
+.tema-op[aria-checked="true"] { background: var(--turquesa-l); color: var(--turquesa-d); }
+.tema-op .tema-muestra {
+  width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
+  display: flex; align-items: center; justify-content: center; font-size: .95rem;
+  border: 2px solid var(--blanco); box-shadow: 0 0 0 1.5px var(--gris-200);
+}
+.tema-op .tema-txt { flex: 1; min-width: 0; line-height: 1.2; }
+.tema-op .tema-txt small { display: block; font-weight: 600; font-size: var(--text-xs); color: var(--texto-suave); }
+.tema-op .tema-check { visibility: hidden; font-weight: 900; }
+.tema-op[aria-checked="true"] .tema-check { visibility: visible; }
+
+/* Variante flotante (login): esquina inferior derecha */
+.tema-selector[data-variante="flotante"] { position: fixed; right: 1rem; bottom: 1rem; z-index: 50; }
+.tema-selector[data-variante="flotante"] .tema-btn {
+  width: auto; margin: 0; padding: .55rem .85rem; box-shadow: var(--sombra-md);
+  border-radius: var(--radio-full);
+}
+.tema-selector[data-variante="flotante"] .tema-menu { left: auto; right: 0; }
+
+/* Variante sobre color (portal): botón translúcido, menú hacia abajo */
+.tema-selector[data-variante="sobre-color"] .tema-btn {
+  width: auto; margin: 0; background: rgba(255,255,255,.2);
+  color: #fff; border: 2px solid rgba(255,255,255,.3);
+}
+.tema-selector[data-variante="sobre-color"] .tema-btn:hover { background: rgba(255,255,255,.3); }
+.tema-selector[data-variante="sobre-color"] .tema-puntos i { border-color: rgba(255,255,255,.7); }
+.tema-selector[data-variante="sobre-color"] .tema-menu { bottom: auto; top: calc(100% + 6px); left: auto; right: 0; }
+
+/* en el encabezado del portal el botón es compacto: solo 🎨 + muestras */
+.tema-selector[data-variante="sobre-color"] .tema-nombre { display: none; }
+@media (prefers-reduced-motion: reduce) {
+  .tema-selector.abierto .tema-menu { animation: none; }
+}
