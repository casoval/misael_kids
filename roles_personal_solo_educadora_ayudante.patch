+// El formulario solo ofrece Educadora y Ayudante. Si la ficha (o el usuario
+// elegido) ya tiene otro rol (directora, recepcionista, cocina), se agrega esa
+// única opción para no borrarlo ni cambiárselo sin querer al guardar.
+const ROLES_FORM = ['educadora','ayudante'];
+const ROLES_EXTRA_LABEL = {directora:'Directora', recepcionista:'Recepcionista', cocina:'Cocina'};
+function opcionesRol(rolActual) {
+  const sel = document.getElementById('p-rol');
+  sel.querySelectorAll('option[data-extra]').forEach(o => o.remove());
+  if (rolActual && !ROLES_FORM.includes(rolActual) && ROLES_EXTRA_LABEL[rolActual]) {
+    const o = document.createElement('option');
+    o.value = rolActual; o.textContent = ROLES_EXTRA_LABEL[rolActual];
+    o.setAttribute('data-extra','1');
+    sel.appendChild(o);
+  }
+}
