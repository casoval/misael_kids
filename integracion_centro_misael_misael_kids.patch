+_MAPA_PARENTESCO = {
+    'madre':   Tutor.PARENTESCO_MADRE,
+    'padre':   Tutor.PARENTESCO_PADRE,
+    'tutor':   Tutor.PARENTESCO_TUTOR,
+    'abuelo':  Tutor.PARENTESCO_ABUELO,
