+        <div>
+          <strong>${v.nino_nombre}</strong>
+          <span class="badge ${v.estado_centro_cache==='activo'?'estado-aceptada':'estado-cerrada'}" style="margin-left:8px">
+            paciente #${v.paciente_centro_id} en Centro Misael
+          </span>
+          <div style="font-size:var(--text-xs);color:var(--gris-500)">
+            Vinculado el ${new Date(v.fecha_vinculacion).toLocaleDateString()}
+            ${v.ultima_sincronizacion ? '· Última sync: '+new Date(v.ultima_sincronizacion).toLocaleString() : '· Sin sincronizar aún'}
+          </div>
+        </div>
+        <button class="btn btn-outline btn-sm" onclick="sincronizarPlanesMisael(${v.nino})">
+          🔄 Sincronizar planes/documentos
+        </button>
+      </div>`).join('');
+  } catch (err) {
+    UI.vacio(cont, 'Error: '+err.message, '⚠️');
+  }
+}
+
+async function sincronizarPlanesMisael(ninoId) {
+  try {
+    const resp = await API.post('/misael-link/centro-misael/sincronizar/', { nino_id: ninoId });
+    UI.toast(resp.importados > 0
+      ? `✅ ${resp.importados} documento(s) nuevo(s) importado(s)`
+      : 'Ya estaba todo sincronizado, sin documentos nuevos', 'exito');
+    cargarVinculados();
+    if (document.getElementById('panel-planes').classList.contains('activo')) cargarPlanesMisael();
+  } catch (err) {
+    UI.toast('No se pudo sincronizar: '+err.message, 'error');
+  }
+}
+
 inicializar();
 </script>
