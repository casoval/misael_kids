+/* ═══ 🌳 SELVA ════════════════════════════════════════════════ */
+:root[data-tema="selva"] {
+  /* verde musgo → lima · acento agua de río */
+  --turquesa:    #4D7C0F;
+  --turquesa-d:  #3F6212;
+  --turquesa-l:  #ECFCCB;
+  --turquesa-xl: #F7FEE7;
+  --primario-rgb: 77, 124, 15;
+  --primario-2:  #65A30D;
+  --violeta:     #0E7490;
+  --violeta-d:   #155E75;
+  --violeta-l:   #CFFAFE;
+  --violeta-xl:  #E3F8FB;
+
+  --fondo-panel: linear-gradient(160deg, #F7FBEF 0%, #EAF3DC 100%);
+  --fondo-grad:  linear-gradient(135deg, #ECFCCB 0%, #F7FEE7 40%, #FEF9C3 70%, #DCFCE7 100%);
+  --grad-hero:   linear-gradient(135deg, #3F6212, #0F766E);
+  --deco-header: '🦜🌴🐒';
+
+  --radio-lg: 1.1rem;
+  --radio-xl: 1.75rem;
+}
+
+
+/* ═══ 🦙 ALTIPLANO ════════════════════════════════════════════
+   Inspirado en los colores de los textiles andinos (tierra, ocre y
+   azul de lago). Usa bandas de color, no símbolos patrios ni sagrados. */
+:root[data-tema="altiplano"] {
+  --turquesa:    #B45309;
+  --turquesa-d:  #9A3412;
+  --turquesa-l:  #F5E6D3;
+  --turquesa-xl: #FBF3E8;
+  --primario-rgb: 180, 83, 9;
+  --primario-2:  #D97706;
+  --violeta:     #0369A1;
+  --violeta-d:   #075985;
+  --violeta-l:   #E0F2FE;
+  --violeta-xl:  #E6F4FB;
+
+  --fondo-panel: linear-gradient(160deg, #FBF5EA 0%, #F3E8D6 100%);
+  --fondo-grad:  linear-gradient(135deg, #FDECD2 0%, #FBF5EA 40%, #E0F2FE 75%, #F5E6D3 100%);
+  --grad-hero:   linear-gradient(135deg, #9A3412, #B45309 55%, #0369A1);
+  --deco-header: '🦙⛰️🌄';
+
+  --radio-md: .5rem;
+  --radio-lg: .875rem;
+  --radio-xl: 1.25rem;
+}
+/* banda de color tipo aguayo bajo la barra superior */
+:root[data-tema="altiplano"] .topbar {
+  border-bottom: 5px solid transparent;
+  border-image: repeating-linear-gradient(90deg,
+    #B45309 0 28px, #0369A1 28px 40px, #F59E0B 40px 68px, #7C2D12 68px 80px, #0E7490 80px 92px) 1;
+}
+
+
+/* ═══ 👁️ ALTO CONTRASTE (accesibilidad) ═══════════════════════
+   Texto negro sobre blanco, bordes negros marcados, letra más grande,
+   tipografía de alta legibilidad y sin animaciones ni adornos.
+   Todos los pares texto/fondo superan 7:1 (nivel AAA). */
+:root[data-tema="altocontraste"] {
+  --turquesa:    #0B3BCC;
+  --turquesa-d:  #00228F;
+  --turquesa-l:  #DCE6FF;
+  --turquesa-xl: #EEF3FF;
+  --primario-rgb: 11, 59, 204;
+  --primario-2:  #0B3BCC;
+  --violeta:     #5B1FA8;
+  --violeta-d:   #3B0D7A;
+  --violeta-l:   #EBDDFF;
+  --violeta-xl:  #F3EAFF;
+
+  /* estados: oscuros para el texto, tintes claros para el fondo */
+  --verde:       #0A7A2F;  --verde-d:    #064E1C;  --verde-l:    #D7F5E1;
+  --coral:       #A80F16;  --coral-d:    #8A0A10;  --coral-l:    #FFE0E0;  --coral-xl: #FFF0F0;
+  --amarillo:    #FFD000;  --amarillo-d: #5C4700;  --amarillo-l: #FFF0A6;  --amarillo-txt: #4A3800;
+  --naranja:     #9A3412;  --naranja-l:   #FFE2C7;
+  --txt-rojo:    #9B0F14;  --txt-verde:  #0A5C24;  --txt-azul:   #0B2FA0;  --txt-naranja: #6B2410;
+  --amarillo-l2: #FFE97A;  --amarillo-l3: #FFD84D;  --amarillo-xl: #FFF5C2;
+
+  /* texto: negro y grises muy oscuros */
+  --texto:       #000000;
+  --texto-suave: #262626;
+  --gris-400:    #404040;
+  --gris-500:    #333333;
+  --gris-600:    #1F1F1F;
+  --gris-700:    #111111;
+  --gris-800:    #000000;
+
+  --fondo-panel: #F2F2F2;
+  --fondo-grad:  linear-gradient(#FFFFFF, #F2F2F2);
+  --grad-hero:   linear-gradient(135deg, #00228F, #0B3BCC);
+  --login-card-bg: #FFFFFF;
+  --deco-header: '';
+
+  /* sin sombras: los bordes definen las formas */
+  --sombra-sm: 0 0 0 0 transparent;  --sombra-md: 0 0 0 0 transparent;
+  --sombra-lg: 0 0 0 0 transparent;  --sombra-xl: 0 0 0 0 transparent;
+  --sombra-color: 0 0 0 0 transparent;
+
+  --font-body:    'Atkinson Hyperlegible', 'Nunito', system-ui, sans-serif;
+  --font-display: 'Atkinson Hyperlegible', 'Nunito', system-ui, sans-serif;
+}
+:root[data-tema="altocontraste"] { font-size: 108%; }   /* base: 92% → ~17px */
+:root[data-tema="altocontraste"] body { line-height: 1.7; }
+
+/* bordes negros y marcados */
+:root[data-tema="altocontraste"] .card,
+:root[data-tema="altocontraste"] .stat-card,
+:root[data-tema="altocontraste"] .tarjeta-nino,
+:root[data-tema="altocontraste"] .tabla-wrap,
+:root[data-tema="altocontraste"] .modal,
+:root[data-tema="altocontraste"] .usuario-card { border: 2px solid #000; }
+:root[data-tema="altocontraste"] .sidebar { border-right: 3px solid #000; }
+:root[data-tema="altocontraste"] .topbar  { border-bottom: 3px solid #000; }
+:root[data-tema="altocontraste"] .form-input,
+:root[data-tema="altocontraste"] .form-select,
+:root[data-tema="altocontraste"] .form-textarea { border: 2px solid #000; }
+:root[data-tema="altocontraste"] .btn { border: 2px solid #000; }
+:root[data-tema="altocontraste"] .chip,
+:root[data-tema="altocontraste"] .alerta-info,
+:root[data-tema="altocontraste"] .alerta-exito,
+:root[data-tema="altocontraste"] .alerta-warn,
+:root[data-tema="altocontraste"] .alerta-peligro { border: 2px solid currentColor; }
+:root[data-tema="altocontraste"] .nav-item.activo { outline: 3px solid #000; outline-offset: -3px; }
+
+/* títulos en negrita (Atkinson solo se pide en 400 y 700) y enlaces subrayados */
+:root[data-tema="altocontraste"] .sidebar-logo .logo-texto h2,
+:root[data-tema="altocontraste"] .topbar-titulo,
+:root[data-tema="altocontraste"] .card-titulo,
+:root[data-tema="altocontraste"] .stat-info .valor,
+:root[data-tema="altocontraste"] .modal-titulo,
+:root[data-tema="altocontraste"] .tn-nombre,
+:root[data-tema="altocontraste"] .tn-monto,
+:root[data-tema="altocontraste"] h1,
+:root[data-tema="altocontraste"] h2,
+:root[data-tema="altocontraste"] h3 { font-weight: 700; }
+:root[data-tema="altocontraste"] a:not(.btn):not(.nav-item) { text-decoration: underline; }
+
+/* foco muy visible para quien navega con teclado */
+:root[data-tema="altocontraste"] :focus-visible { outline: 4px solid #FF8C00 !important; outline-offset: 2px !important; }
+
+/* sin adornos ni movimiento */
+:root[data-tema="altocontraste"] .burbuja,
+:root[data-tema="altocontraste"] .estrellita,
+:root[data-tema="altocontraste"] .bg-burbujas::before,
+:root[data-tema="altocontraste"] .bg-burbujas::after { display: none; }
+:root[data-tema="altocontraste"] *,
+:root[data-tema="altocontraste"] *::before,
+:root[data-tema="altocontraste"] *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
+
+/* el propio selector también en alto contraste */
+:root[data-tema="altocontraste"] .tema-btn,
+:root[data-tema="altocontraste"] .tema-menu { border: 2px solid #000; }
