+// Vista de tarjetas: mismos datos y acciones que la fila de la tabla.
+function tarjetaNino(n) {
+  const e = Vista._esc;
+  const badges = [
+    n.activo ? '<span class="chip chip-verde">✅ Activo</span>' : '<span class="chip chip-coral">❌ Inactivo</span>',
+    n.vinculado_centro_misael ? '<span class="chip chip-violeta" title="Vinculado con un paciente de Centro Misael">🔗 Centro Misael</span>' : '',
+    n.tiene_plan_misael ? '<span class="chip chip-violeta">🧠 Plan Misael</span>' : '',
+    n.alergias ? `<span class="chip chip-coral" title="${e(n.alergias)}">⚠️ Alergias</span>` : '',
+  ].join(' ');
+  const tutores = (n.tutores_resumen||[]).length
+    ? n.tutores_resumen.map(t => `<span class="chip ${t.es_principal?'chip-violeta':'chip-gris'}" style="margin:1px">${t.es_principal?'⭐ ':''}${e(t.nombre)}</span>`).join(' ')
+    : '<span class="chip chip-coral">⚠️ Sin tutor</span>';
+  const genero = n.genero==='M' ? '👦 Masc.' : n.genero==='F' ? '👧 Fem.' : '⚧️ Otro';
+  return Vista.tarjeta(n, {
+    clase: !n.activo ? 'tn-neutro' : (n.tutores_resumen||[]).length ? (n.vinculado_centro_misael ? 'tn-violeta' : 'tn-ok') : 'tn-aviso',
+    sub: `🎂 ${e(UI.edad(n.edad_en_meses, true))} · ${genero}`,
+    badges,
+    datos: Vista.dato('Nacimiento', e(UI.fecha(n.fecha_nacimiento)))
+         + Vista.dato('Tutores', tutores, true),
+    acciones: `<button class="btn btn-outline btn-sm" onclick="verPerfil('${n.id}')">👁 Ver</button>
+      <button class="btn btn-outline btn-sm" onclick="editar('${n.id}')">✏️ Editar</button>
+      <button class="btn btn-sm" style="background:var(--coral-l);color:var(--coral-d);border:1.5px solid var(--coral)"
+        onclick="eliminar('${n.id}','${e(n.nombre_completo.replace(/'/g,"\\'"))}')">🗑️</button>`,
+  });
+}
