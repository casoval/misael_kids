 const ROLES_PERSONAL = ['educadora','ayudante','directora','recepcionista','cocina'];
+
+// Educadora, ayudante y tutor ya no se ofrecen al crear un usuario (se crean
+// desde Personal y desde la ficha del niño, que dejan todo vinculado). Al
+// EDITAR un usuario que ya tiene uno de esos roles, se muestra solo su rol
+// actual para que no quede en blanco ni se cambie sin querer.
+const ROLES_OCULTOS_LABEL = {educadora:'Educadora', ayudante:'Ayudante', tutor:'Tutor / Padre'};
+function opcionesRol(rolActual) {
+  const sel = document.getElementById('u-rol');
+  sel.querySelectorAll('option[data-extra]').forEach(o => o.remove());
+  if (rolActual && ROLES_OCULTOS_LABEL[rolActual]) {
+    const o = document.createElement('option');
+    o.value = rolActual; o.textContent = ROLES_OCULTOS_LABEL[rolActual];
+    o.setAttribute('data-extra','1');
+    sel.appendChild(o);
+  }
+}
