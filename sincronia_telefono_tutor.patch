diff --git a/ninos/migrations/0003_sincronizar_telefono_tutor_usuario.py b/ninos/migrations/0003_sincronizar_telefono_tutor_usuario.py
new file mode 100644
index 0000000..1ff3fdc
--- /dev/null
+++ b/ninos/migrations/0003_sincronizar_telefono_tutor_usuario.py
@@ -0,0 +1,27 @@
+"""
+Corrige datos existentes: tutores con cuenta de portal cuyo Usuario quedó sin
+teléfono (o con uno distinto) porque el formulario nunca lo enviaba.
+El teléfono de la ficha del tutor (el de la tarjeta del niño) es la fuente.
+"""
+from django.db import migrations
+
+
+def sincronizar(apps, schema_editor):
+    Tutor = apps.get_model('ninos', 'Tutor')
+    for t in Tutor.objects.exclude(usuario__isnull=True).exclude(telefono='').select_related('usuario'):
+        u = t.usuario
+        if u.telefono != t.telefono:
+            u.telefono = t.telefono
+            u.save(update_fields=['telefono'])
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        ('ninos', '0002_alter_tutor_ci'),
+        ('accounts', '0004_rol_recepcionista'),
+    ]
+
+    operations = [
+        migrations.RunPython(sincronizar, migrations.RunPython.noop),
+    ]
diff --git a/ninos/models.py b/ninos/models.py
index 94d49a8..099fbfb 100644
--- a/ninos/models.py
+++ b/ninos/models.py
@@ -88,6 +88,24 @@ class Tutor(ModeloBase):
         verbose_name_plural = 'Tutores'
         ordering            = ['apellidos', 'nombres']
 
+    def save(self, *args, **kwargs):
+        super().save(*args, **kwargs)
+        # La tarjeta del niño muestra Tutor.telefono, pero la cuenta del portal
+        # (Usuario) tiene su propio campo. Se mantienen iguales para que el
+        # teléfono cargado en la ficha también aparezca en el usuario.
+        u = self.usuario
+        if not u:
+            return
+        campos = []
+        if u.nombres != self.nombres:
+            u.nombres = self.nombres; campos.append('nombres')
+        if u.apellidos != self.apellidos:
+            u.apellidos = self.apellidos; campos.append('apellidos')
+        if self.telefono and u.telefono != self.telefono:
+            u.telefono = self.telefono; campos.append('telefono')
+        if campos:
+            u.save(update_fields=campos)
+
     def __str__(self):
         return f'{self.nombres} {self.apellidos} ({self.get_parentesco_display()})'
 
