--- a/frontend/css/base.css
+++ b/frontend/css/base.css
@@ -50,6 +50,7 @@ body {
 .app-layout {
   display: flex;
   min-height: 100vh;
+  min-height: 100dvh;
 }
 
 /* ── Sidebar ── */
@@ -207,20 +208,24 @@ body {
 .main-content {
   margin-left: var(--sidebar-w);
   flex: 1;
+  min-width: 0;            /* evita que tablas/grids anchos estiren toda la página */
   display: flex;
   flex-direction: column;
   min-height: 100vh;
+  min-height: 100dvh;
 }
 
 /* ── Topbar ── */
 .topbar {
-  height: var(--topbar-h);
+  min-height: var(--topbar-h);
   background: var(--blanco);
   border-bottom: 2px solid var(--gris-100);
   display: flex;
   align-items: center;
   justify-content: space-between;
-  padding: 0 var(--gap-xl);
+  flex-wrap: wrap;
+  gap: .4rem var(--gap-md);
+  padding: .4rem var(--gap-xl);
   position: sticky;
   top: 0;
   z-index: 50;
@@ -228,13 +233,32 @@ body {
 }
 .topbar-titulo {
   font-family: var(--font-display);
-  font-size: var(--text-2xl);
+  font-size: clamp(1.15rem, 1rem + 1vw, 1.5rem);
   color: var(--texto);
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
 }
 .topbar-acciones {
   display: flex;
   align-items: center;
-  gap: var(--gap-md);
+  flex-wrap: wrap;
+  gap: var(--gap-sm) var(--gap-md);
+  margin-left: auto;
+  justify-content: flex-end;
+}
+/* Selector global de sucursal (lo inserta components.js) */
+.selector-sucursal-wrap {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-left: var(--gap-sm);
+  min-width: 0;
+}
+.selector-sucursal-wrap .form-select {
+  max-width: 230px;
+  font-weight: 700;
 }
 
 /* ── Menú móvil (botón hamburguesa + fondo oscuro) ── */
@@ -263,8 +287,11 @@ body {
 
 /* ── Área de página ── */
 .pagina {
-  padding: var(--gap-xl);
+  padding: clamp(.75rem, 2.2vw, 2rem);
   flex: 1;
+  width: 100%;
+  max-width: 1680px;       /* en monitores muy anchos el contenido no se estira sin fin */
+  margin-inline: auto;
 }
 
 /* ══════════════════════════════════════
@@ -618,30 +645,6 @@ tbody tr:hover { background: var(--gris-50); }
 .hidden { display: none !important; }
 .ml-auto { margin-left: auto; }
 
-/* ══════════════════════════════════════
-   RESPONSIVE
-══════════════════════════════════════ */
-
-@media (max-width: 1024px) {
-  .grid-4 { grid-template-columns: repeat(2, 1fr); }
-}
-@media (max-width: 768px) {
-  .sidebar { transform: translateX(-100%); }
