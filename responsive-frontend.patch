-}
-
 /* ══════════════════════════════════════
    VALIDACIONES DE FORMULARIO
 ══════════════════════════════════════ */
@@ -819,8 +822,278 @@ tbody tr:hover { background: var(--gris-50); }
   color: var(--texto-suave); font-weight: 600;
 }
 
+
+
+/* ═══════════════════════════════════════════════════════════════
+   RESPONSIVE — sistema de 5 rangos de pantalla
+   ───────────────────────────────────────────────────────────────
+   XXL  ≥ 1920px   monitores grandes / TV   (tipografía algo mayor)
+   XL   ≥ 1440px   escritorio amplio        (sidebar ancho, 4–5 cols)
+   LG   1025–1439  portátil / escritorio    (diseño base)
+   MD   769–1024   tablet                   (sidebar compacto de iconos)
+   SM   ≤ 768      móvil / tablet vertical  (menú lateral deslizable)
+   XS   ≤ 480      móvil pequeño            (todo en 1 columna)
+   Va al FINAL del archivo a propósito: debe ganar a las reglas previas.
+═══════════════════════════════════════════════════════════════ */
+
+/* ── Base fluida ─────────────────────────────────────────────── */
+html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
+img, svg, video { max-width: 100%; height: auto; }
+.grid-stats { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
+.tabla-wrap { -webkit-overflow-scrolling: touch; max-width: 100%; }
+.card, .stat-card { min-width: 0; }
+.card { padding: clamp(.85rem, 1.6vw, 1.5rem); }
+.card-header { flex-wrap: wrap; gap: var(--gap-sm); }
+.modal-header { gap: var(--gap-sm); }
+
+/* Pestañas: una sola fila con scroll horizontal en vez de romper el diseño */
+.page-tabs {
+  overflow-x: auto;
+  flex-wrap: nowrap;
+  scrollbar-width: none;
+  -webkit-overflow-scrolling: touch;
+}
+.page-tabs::-webkit-scrollbar { display: none; }
+.page-tab { white-space: nowrap; flex-shrink: 0; }
+
+/* ── XXL · ≥ 1920px ──────────────────────────────────────────── */
+@media (min-width: 1920px) {
+  html { font-size: 104%; }
+  .pagina { max-width: 1840px; }
+}
+
+/* ── XL · ≥ 1440px ───────────────────────────────────────────── */
+@media (min-width: 1440px) {
+  :root { --sidebar-w: 232px; --topbar-h: 60px; }
+  .grid-tarjetas { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
+  .grid-stats    { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
+}
+
+/* ── ≤ 1280px: tableros de 4 columnas pasan a 2 ──────────────── */
+@media (max-width: 1280px) {
+  .grid-4 { grid-template-columns: repeat(2, 1fr); }
+}
+
+/* ── MD · tablet 769–1024px: sidebar compacto (solo iconos) ──── */
+@media (min-width: 769px) and (max-width: 1024px) {
+  :root { --sidebar-w: 72px; }
+  thead th { padding: .7rem .6rem; }
+  tbody td { padding: .7rem .6rem; }
+  .grid-3 { grid-template-columns: repeat(2, 1fr); }
+
+  .sidebar { overflow: hidden; transition: width var(--trans-base), box-shadow var(--trans-base); }
+  .sidebar-logo { padding: 1rem 0; justify-content: center; }
+  .sidebar-logo .logo-texto { display: none; }
+  .nav-seccion {
+    font-size: 0; padding: 0; height: 2px; margin: 8px 16px;
+    background: var(--gris-100); border-radius: 2px;
+  }
+  .nav-item {
+    position: relative; font-size: 0; gap: 0;
+    justify-content: center; padding: .4rem 0;
+    margin: 2px 10px; width: calc(100% - 20px);
+  }
+  .nav-item .nav-icon { font-size: 1.15rem; }
+  .nav-item > span:not(.badge) { display: none; }
+  .nav-item .badge { position: absolute; top: 0; right: 0; min-width: 18px; padding: 0 5px; }
+  .sidebar-footer { padding: var(--gap-sm); }
+  .usuario-card { flex-direction: column; padding: 6px; gap: 6px; }
+  .usuario-info { display: none; }
+
+  /* Al pasar el cursor / tocar, el menú se expande por encima del contenido */
+  .sidebar:hover, .sidebar:focus-within { width: 224px; box-shadow: var(--sombra-xl); }
+  .sidebar:hover .sidebar-logo, .sidebar:focus-within .sidebar-logo { padding: 1.25rem var(--gap-lg); justify-content: flex-start; }
+  .sidebar:hover .logo-texto, .sidebar:focus-within .logo-texto { display: block; }
+  .sidebar:hover .nav-seccion, .sidebar:focus-within .nav-seccion {
+    font-size: var(--text-xs); height: auto; background: none;
+    padding: var(--gap-sm) var(--gap-lg) var(--gap-xs); margin: var(--gap-sm) 0 0;
+  }
+  .sidebar:hover .nav-item, .sidebar:focus-within .nav-item {
+    font-size: var(--text-sm); gap: var(--gap-sm); justify-content: flex-start;
+    padding: .65rem var(--gap-lg); margin: 2px var(--gap-sm); width: calc(100% - 1rem);
+  }
+  .sidebar:hover .nav-item > span:not(.badge), .sidebar:focus-within .nav-item > span:not(.badge) { display: inline; }
+  .sidebar:hover .nav-item .badge, .sidebar:focus-within .nav-item .badge { position: static; }
+  .sidebar:hover .usuario-card, .sidebar:focus-within .usuario-card { flex-direction: row; gap: var(--gap-sm); padding: var(--gap-sm); }
+  .sidebar:hover .usuario-info, .sidebar:focus-within .usuario-info { display: block; }
+}
+
+/* ── SM · ≤ 768px: móvil y tablet vertical ───────────────────── */
+@media (max-width: 768px) {
+  /* Menú lateral deslizable */
+  .sidebar {
+    width: min(86vw, 300px);
+    transform: translateX(-100%);
+    box-shadow: none;
+    visibility: hidden;
+    transition: transform var(--trans-base), visibility 0s linear var(--trans-base);
+  }
+  .sidebar.abierto {
+    transform: translateX(0);
+    box-shadow: var(--sombra-xl);
+    visibility: visible;
+    transition: transform var(--trans-base), visibility 0s;
+  }
+  body:has(.sidebar.abierto) { overflow: hidden; }   /* bloquea el scroll de fondo con el menú abierto */
+  .main-content { margin-left: 0; }
+  .btn-menu-movil { display: flex; }
+
+  /* Topbar: ☰ + título arriba; selector y botones debajo. No queda fijo (puede
+     ocupar 2–3 filas); el botón ☰ flotante lo reemplaza al hacer scroll. */
+  .topbar { position: static; padding: .45rem var(--gap-md); gap: .4rem var(--gap-sm); }
+  .btn-menu-flotante {
+    position: fixed; top: .6rem; left: .6rem; z-index: 90;
+    width: 44px; height: 44px; border: none; border-radius: 50%;
+    background: var(--blanco); color: var(--texto);
+    font-size: 1.35rem; line-height: 1; cursor: pointer;
+    box-shadow: var(--sombra-lg); border: 1.5px solid var(--gris-100);
+    display: flex; align-items: center; justify-content: center;
+    opacity: 0; transform: scale(.7); pointer-events: none;
+    transition: opacity var(--trans-fast), transform var(--trans-fast);
+  }
+  .btn-menu-flotante.visible { opacity: 1; transform: scale(1); pointer-events: auto; }
+  .selector-sucursal-wrap .form-select { min-height: 40px; padding-top: .4rem; padding-bottom: .4rem; }
+  /* Algunas páginas envuelven el título en un <div> en línea: se "disuelve" para
+     que título y selector de sucursal se acomoden como hijos directos del topbar */
+  .topbar > div[style*="display:flex"] { display: contents !important; }
+  .topbar-titulo { flex: 1 1 0; font-size: var(--text-xl); }
+  .selector-sucursal-wrap { order: 3; flex: 1 1 100%; margin-left: 0; }
+  .selector-sucursal-wrap .form-select { max-width: none; width: 100%; }
+  .topbar-acciones { order: 4; flex: 1 1 100%; margin-left: 0; justify-content: stretch; gap: var(--gap-sm); }
+  .topbar-acciones > * { flex: 1 1 auto; justify-content: center; }
+  .topbar-acciones .btn { padding: .5rem .9rem; }
+
+  /* Cuadrículas */
+  .grid-2, .grid-3 { grid-template-columns: 1fr; }
+  .grid-4 { grid-template-columns: repeat(2, 1fr); }
+  .grid-2, .grid-3, .grid-4 { gap: var(--gap-md); }
+
+  /* Formularios: 16px evita el zoom automático de iOS al enfocar un campo */
+  .form-input, .form-select, .form-textarea { font-size: 16px; }
+  .form-grupo[style*="min-width"] { min-width: 0 !important; flex: 1 1 calc(50% - var(--gap-md)) !important; }
+
+  /* Modales como "hoja inferior" */
+  .modal-overlay { align-items: flex-end; padding: 0; }
+  .modal {
+    max-width: 100% !important; width: 100%;
+    border-radius: var(--radio-xl) var(--radio-xl) 0 0;
+    padding: var(--gap-lg) var(--gap-md);
+    max-height: 92vh; max-height: 92dvh;
+    transform: translateY(40px);
+  }
+  .modal-overlay.abierto .modal { transform: translateY(0); }
+
+  /* Avisos (toast) a todo el ancho */
+  body > div[style*="position:fixed"][style*="bottom:24px"] {
+    left: var(--gap-md) !important; right: var(--gap-md) !important;
+    bottom: var(--gap-md) !important; max-width: none !important;
+  }
+
+  .stat-card { padding: var(--gap-md); }
+  .vista-barra { justify-content: stretch; }
+  .vista-toggle { width: 100%; }
+  .vista-toggle button { flex: 1; }
+}
+
+/* ── Tablas → tarjetas apiladas en móvil ─────────────────────────
+   components.js agrega .tabla-apilada y data-label a cada celda. */
+@media (max-width: 600px) {
+  .tabla-wrap:has(> .tabla-apilada) { border: none; overflow: visible; background: none; }
+  .tabla-apilada, .tabla-apilada tbody, .tabla-apilada tr, .tabla-apilada td { display: block; width: 100%; }
+  .tabla-apilada thead { display: none; }
+  .tabla-apilada tbody tr {
+    background: var(--blanco);
+    border: 1.5px solid var(--gris-100);
+    border-radius: var(--radio-lg);
+    padding: .35rem .85rem;
+    margin-bottom: var(--gap-sm);
+    box-shadow: var(--sombra-sm);
+  }
+  .tabla-apilada tbody tr:hover { background: var(--blanco); }
+  .tabla-apilada tbody td {
+    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
+    gap: .25rem var(--gap-md);
+    padding: .5rem 0;
+    border-bottom: 1px dashed var(--gris-100);
+    text-align: right;
+    min-width: 0; overflow-wrap: anywhere;
+  }
+  .tabla-apilada tbody td:last-child { border-bottom: none; }
+  .tabla-apilada tbody td::before {
+    content: attr(data-label);
+    flex: 0 0 auto; max-width: 42%;
+    font-size: var(--text-xs); font-weight: 700; letter-spacing: .05em;
+    text-transform: uppercase; color: var(--texto-suave); text-align: left;
+  }
+  .tabla-apilada tbody td[data-label=""]::before,
+  .tabla-apilada tbody td[colspan]::before { display: none; }
+  .tabla-apilada tbody td[colspan] { justify-content: center; text-align: center; }
+  .tabla-apilada tbody td > div[style*="display:flex"] { flex-wrap: wrap; justify-content: flex-end; }
+}
+
+/* ── XS · ≤ 480px: móvil pequeño ─────────────────────────────── */
 @media (max-width: 480px) {
+  .pagina { padding: .65rem; }
+  .card { border-radius: var(--radio-lg); }
+  .card-titulo { font-size: var(--text-lg); }
+  .grid-4 { grid-template-columns: 1fr 1fr; gap: var(--gap-sm); }
+  .grid-stats { grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr)); gap: var(--gap-sm); }
   .grid-tarjetas { grid-template-columns: 1fr; }
+  .form-grupo[style*="min-width"] { flex: 1 1 calc(50% - var(--gap-sm)) !important; }
+  .form-grupo[style*="flex:1"][style*="min-width"] { flex: 1 1 100% !important; }   /* buscador: ancho completo */
+  .topbar-acciones .btn { white-space: normal; text-align: center; line-height: 1.2; }
+
+  .stat-card, .metric-card { padding: var(--gap-sm) var(--gap-md); gap: var(--gap-sm); }
+  .stat-icon { width: 38px; height: 38px; font-size: 1.3rem; }
+  .stat-info .valor { font-size: var(--text-2xl); }
+  .stat-info .etiqueta { font-size: var(--text-xs); }
+
+  .topbar-titulo span { display: none; }
+  .topbar-acciones .btn { font-size: var(--text-xs); }
+  .page-tab { padding: .6rem var(--gap-md); }
+  .modal-titulo { font-size: var(--text-lg); }
+  .tn-datos { grid-template-columns: 1fr 1fr; }
+  .btn-lg { padding: .75rem 1.5rem; }
+}
+
+/* ── ≤ 360px: pantallas muy angostas ─────────────────────────── */
+@media (max-width: 360px) {
+  .grid-4 { grid-template-columns: 1fr; }
+  .tn-datos { grid-template-columns: 1fr; }
+  .btn { padding: .55rem 1rem; }
+}
+
+/* ── Pantallas táctiles: áreas de toque cómodas (≥ 40px) ─────── */
+@media (pointer: coarse) {
+  .btn { min-height: 40px; }
+  .btn-sm { min-height: 36px; }
+  .btn-icon { min-width: 40px; }
+  .nav-item { min-height: 44px; }
+  .form-input, .form-select { min-height: 44px; }
+  .modal-cerrar { width: 40px; height: 40px; }
+  .page-tab { min-height: 44px; }
+  .vista-toggle button { min-height: 36px; }
+}
+
+/* ── Orientación horizontal en móvil: modales y menú caben ───── */
+@media (max-height: 500px) and (orientation: landscape) {
+  .modal { max-height: 96vh; max-height: 96dvh; }
+  .sidebar-logo { padding: .6rem var(--gap-lg); }
+}
+
+/* ── Respetar "reducir movimiento" del sistema ───────────────── */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
+}
+
+/* Botones de pestañas largos (p. ej. Cobros/Movimientos): permiten salto de línea en móvil */
+@media (max-width: 600px) {
+  .tab-cobros-btn { white-space: normal; text-align: left; flex: 1 1 100%; justify-content: center; }
+}
+
+/* Tablet / móvil horizontal (601–1024px): tablas con scroll, pero la 1.ª columna (nombre) no se aplasta */
+@media (min-width: 601px) and (max-width: 1024px) {
+  .tabla-wrap tbody td:first-child { min-width: 170px; }
 }
 
 /* ── Selector de fechas (flatpickr, ver js/fechas.js) ───────── */
diff --git a/frontend/js/components.js b/frontend/js/components.js
index b5de112..992c468 100644
--- a/frontend/js/components.js
+++ b/frontend/js/components.js
@@ -313,7 +313,7 @@ function _pintarSidebar(items, paginaActiva, usr) {
     const activo = paginaActiva && item.href.includes(paginaActiva) ? 'activo' : '';
     const target = item.externo ? ' target="_blank" rel="noopener"' : '';
     const extraStyle = item.externo ? 'opacity:.75;border-top:1px dashed var(--gris-200);margin-top:4px;padding-top:var(--gap-sm)' : '';
-    return `<a class="nav-item ${activo}" href="${item.href}"${target} style="${extraStyle}">
+    return `<a class="nav-item ${activo}" href="${item.href}" title="${item.label}"${target} style="${extraStyle}">
       <div class="nav-icon">${item.icon}</div> ${item.label}${item.externo?' <span style="font-size:.6rem;opacity:.6">↗</span>':''}
     </a>`;
   }).join('');
@@ -362,6 +362,21 @@ function insertarMenuMovil() {
     backdrop.onclick = cerrarSidebarMovil;
     document.body.appendChild(backdrop);
   }
+
+  // Botón ☰ flotante: en móvil el topbar no queda fijo (ocuparía hasta 3 filas),
+  // así que cuando se sale de pantalla aparece este atajo para abrir el menú.
+  if (topbar && !document.getElementById('btn-menu-flotante') && 'IntersectionObserver' in window) {
+    const fab = document.createElement('button');
+    fab.id = 'btn-menu-flotante';
+    fab.className = 'btn-menu-flotante';
+    fab.type = 'button';
+    fab.setAttribute('aria-label', 'Abrir menú');
+    fab.innerHTML = '☰';
+    fab.onclick = toggleSidebarMovil;
+    document.body.appendChild(fab);
+    new IntersectionObserver(([e]) => fab.classList.toggle('visible', !e.isIntersecting))
+      .observe(topbar);
+  }
 }
 
 function toggleSidebarMovil() {
@@ -412,16 +427,11 @@ const Sucursal = {
     if (!topbar || document.getElementById('selector-sucursal')) return;
 
     const wrap = document.createElement('div');
-    wrap.style.display = 'flex';
-    wrap.style.alignItems = 'center';
-    wrap.style.gap = '8px';
-    wrap.style.marginLeft = 'var(--gap-lg)';
+    wrap.className = 'selector-sucursal-wrap';   // estilos y responsive en base.css
 
     const sel = document.createElement('select');
     sel.id = 'selector-sucursal';
     sel.className = 'form-select';
-    sel.style.maxWidth = '230px';
-    sel.style.fontWeight = '700';
 
     let opciones = '';
